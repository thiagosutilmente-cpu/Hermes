40 425 moveto (            speedKmh = calculatedSpeedKmh,) show
40 416 moveto (            lat = location.latitude,) show
40 407 moveto (            lng = location.longitude,) show
40 398 moveto (            accuracy = location.accuracy) show
40 389 moveto (        \)) show
40 380 moveto (    }) show
40 371 moveto () show
40 362 moveto (    /**) show
40 353 moveto (     * Aplica a lógica da trava com histerese \(trava > 10 km/h e destrava < 8.5 km/h\)) show
40 344 moveto (     */) show
40 335 moveto (    private fun updateSpeedAndEvaluateLock\() show
40 326 moveto (        speedKmh: Double,) show
40 317 moveto (        lat: Double,) show
40 308 moveto (        lng: Double,) show
40 299 moveto (        accuracy: Float) show
40 290 moveto (    \) {) show
40 281 moveto (        val currentLocked = _state.value.isLocked) show
40 272 moveto (        val newLocked = when {) show
40 263 moveto (            speedKmh >= LOCK_SPEED_THRESHOLD_KMH -> true) show
40 254 moveto (            speedKmh <= UNLOCK_HYSTERESIS_THRESHOLD_KMH -> false) show
40 245 moveto (            else -> currentLocked // Faixa de histerese para evitar oscilação) show
40 236 moveto (        }) show
40 227 moveto () show
40 218 moveto (        val wasLocked = currentLocked) show
40 209 moveto (        val speedRounded = Math.round\(speedKmh * 10.0\) / 10.0) show
40 200 moveto () show
40 191 moveto (        _state.value = _state.value.copy\() show
40 182 moveto (            currentSpeedKmh = speedRounded,) show
40 173 moveto (            isLocked = newLocked,) show
40 164 moveto (            latitude = lat,) show
40 155 moveto (            longitude = lng,) show
40 146 moveto (            accuracyMeters = accuracy,) show
40 137 moveto (            statusMessage = if \(newLocked\) {) show
