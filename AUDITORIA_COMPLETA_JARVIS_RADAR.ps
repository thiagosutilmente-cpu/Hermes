40 425 moveto (        val isLeader40 = Math.abs\(leaderRatio - 0.40\) < 0.001) show
40 416 moveto (        val isMaster60 = Math.abs\(masterRatio - 0.60\) < 0.001) show
40 407 moveto (        return isSumEqual && isLeader40 && isMaster60) show
40 398 moveto (    }) show
