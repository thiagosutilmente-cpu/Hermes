40 668 moveto (     */) show
40 659 moveto (    private fun processNewLocation\(location: Location\) {) show
40 650 moveto (        if \(_state.value.isSimulationMode\) return) show
40 641 moveto () show
40 632 moveto (        var calculatedSpeedKmh = 0.0) show
40 623 moveto () show
40 614 moveto (        // 1. Tenta usar o hardware speed do GPS \(m/s -> km/h\)) show
40 605 moveto (        if \(location.hasSpeed\(\) && location.speed >= 0f\) {) show
40 596 moveto (            calculatedSpeedKmh = location.speed.toDouble\(\) * 3.6) show
40 587 moveto (        } else {) show
40 578 moveto (            // 2. Fallback de cálculo geodésico \(delta distância / delta tempo\)) show
40 569 moveto (            val prev = lastLocation) show
40 560 moveto (            val now = System.currentTimeMillis\(\)) show
40 551 moveto (            if \(prev != null && lastLocationTimestamp > 0L\) {) show
40 542 moveto (                val dtSeconds = \(now - lastLocationTimestamp\) / 1000.0) show
40 533 moveto (                if \(dtSeconds in 0.5..10.0\) {) show
40 524 moveto (                    val distMeters = prev.distanceTo\(location\)) show
40 515 moveto (                    val speedMps = distMeters / dtSeconds) show
40 506 moveto (                    calculatedSpeedKmh = \(speedMps * 3.6\).coerceIn\(0.0, 180.0\)) show
40 497 moveto (                }) show
40 488 moveto (            }) show
40 479 moveto (        }) show
40 470 moveto () show
40 461 moveto (        lastLocation = location) show
40 452 moveto (        lastLocationTimestamp = System.currentTimeMillis\(\)) show
40 443 moveto () show
