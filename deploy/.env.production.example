# ==============================================================================
# JARVIS NEURAL COCKPIT - CONFIGURAÇÃO DE PRODUÇÃO (VPS HOSTINGER)
# ==============================================================================
# Preencha apenas os 4 campos abaixo na sua VPS:
#
# 1. Chave da API do Asaas (Painel Asaas > Minha Conta > Integrações > Gerar Chave de API)
ASAAS_API_KEY=sua_chave_asaas_aqui

# 2. URL da sua Evolution API (Ex: http://187.77.248.73:8080 ou domínio com SSL)
EVOLUTION_API_URL=http://187.77.248.73:8080

# 3. Chave Global da sua Evolution API
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui

# 4. Nome da Instância WhatsApp conectada (Ex: jarvis_pro_bot)
EVOLUTION_INSTANCE=jarvis_pro_bot

# 5. Chave do Google Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_gemini_aqui

# 6. Automação Meta Ads (Facebook & Instagram Graph API)
META_ACCESS_TOKEN=seu_meta_access_token_aqui
META_AD_ACCOUNT_ID=act_sua_conta_de_anuncios_aqui

# Porta de execução do FastAPI na VPS (Padrão: 8000)
PORT=8000
HOST=0.0.0.0

