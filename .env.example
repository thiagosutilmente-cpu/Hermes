# ==============================================================================
# JARVIS NEURAL COCKPIT & RADAR DELIVERY - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# ATENÇÃO: Nunca compartilhe este arquivo publicamente.
# No terminal da Hostinger VPS, crie ou edite o arquivo .env:
# nano .env
# ==============================================================================

# 1. CÉREBRO DE IA (ANTHROPIC CLAUDE)
# Obtenha em: https://console.anthropic.com ($5 USD pré-pago)
ANTHROPIC_API_KEY=sk-ant-api03-SEU_TOKEN_AQUI

# 2. CHECKOUT AUTOMÁTICO DE PIX (ASAAS)
# Obtenha sua chave de API no painel do Asaas (Configurações > Integrações)
ASAAS_API_KEY=sua_chave_asaas_aqui

# 3. TRÁFEGO PAGO (META ADS - FACEBOOK / INSTAGRAM)
# Token do Gerenciador de Anúncios e ID da Conta de Anúncios (ex: act_123456789)
META_ACCESS_TOKEN=seu_meta_access_token_aqui
META_AD_ACCOUNT_ID=act_123456789

# 4. ROBÔ DE WHATSAPP (EVOLUTION API OU WEBHOOK)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_evolution_api_key_aqui
EVOLUTION_INSTANCE=jarvis_sales

# 5. CONTROLE DO ADMINISTRADOR
# Celular para receber o relatório diário das 08:00 (com DDI e DDD, ex: 5511999999999)
ADMIN_WHATSAPP_PHONE=5511999999999

# 6. LIMITES DE GOVERNANÇA FINANCEIRA (BLINDAGEM DE CAIXA)
MAX_DAILY_BUDGET_BRL=15.00
MAX_CPC_THRESHOLD_BRL=1.50
MIN_CTR_THRESHOLD_PERCENT=1.20
